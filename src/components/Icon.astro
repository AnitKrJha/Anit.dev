---
/**
 * Icons from Phosphor (https://phosphoricons.com, MIT): one consistent family for UI glyphs and brand logos.
 * The SVGs are imported as strings from the installed package, so the build never needs the network.
 * Brand logos use the "fill" weight and small arrows use "bold", which read better at 14–16px.
 */
import github from "@phosphor-icons/core/fill/github-logo-fill.svg?raw";
import linkedin from "@phosphor-icons/core/fill/linkedin-logo-fill.svg?raw";
import x from "@phosphor-icons/core/fill/x-logo-fill.svg?raw";
import instagram from "@phosphor-icons/core/fill/instagram-logo-fill.svg?raw";
import rss from "@phosphor-icons/core/bold/rss-simple-bold.svg?raw";
import arrowUpRight from "@phosphor-icons/core/bold/arrow-up-right-bold.svg?raw";
import arrowLeft from "@phosphor-icons/core/bold/arrow-left-bold.svg?raw";
import sun from "@phosphor-icons/core/regular/sun.svg?raw";
import moon from "@phosphor-icons/core/regular/moon.svg?raw";
import copy from "@phosphor-icons/core/regular/copy.svg?raw";
import check from "@phosphor-icons/core/bold/check-bold.svg?raw";
import link from "@phosphor-icons/core/bold/link-simple-bold.svg?raw";
import logo from "../icons/logo.svg?raw";
import signature from "../icons/Full Logo.svg?raw";

const icons = {
  github,
  linkedin,
  x,
  instagram,
  rss,
  "arrow-up-right": arrowUpRight,
  "arrow-left": arrowLeft,
  sun,
  moon,
  copy,
  check,
  link,
  logo,
  signature,
};

export type IconName = keyof typeof icons;

type Props = {
  name: IconName;
  size?: number;
  class?: string;
  label?: string;
};

const { name, size = 18, class: className, label } = Astro.props;

/** Wordmarks keep their aspect ratio (width only); glyphs are square. */
const isMark = name === "logo" || name === "signature";

const svg = icons[name]
  .replace(/<!--[\s\S]*?-->/g, "")
  .replace(/<title>[\s\S]*?<\/title>/, "")
  .replace(/(fill|stroke)="#000(000)?"/g, '$1="currentColor"')
  .replace(/<svg([^>]*)>/, (_, attrs: string) => {
    const kept = attrs.replace(/\s(width|height|fill|version)="[^"]*"/g, "");
    const size = isMark ? 'width="100%"' : 'width="100%" height="100%"';
    return `<svg${kept} ${size} fill="currentColor" focusable="false" aria-hidden="true">`;
  })
  .trim();
---

<span
  class:list={["inline-flex shrink-0 items-center justify-center", className]}
  style={isMark ? `width:${size}px` : `width:${size}px;height:${size}px`}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  set:html={svg}
/>
