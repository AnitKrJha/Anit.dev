const stroke = {
  "arrow-up-right": "M7 17 17 7M8 7h9v9",
  "arrow-left": "M19 12H5M12 19l-7-7 7-7",
  sun: "M12 3v1.5M12 19.5V21M4.22 4.22l1.06 1.06M18.72 18.72l1.06 1.06M3 12h1.5M19.5 12H21M4.22 19.78l1.06-1.06M18.72 5.28l1.06-1.06M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z",
  moon: "M20.354 15.354A9 9 0 0 1 8.646 3.646 9.003 9.003 0 0 0 12 21a9.003 9.003 0 0 0 8.354-5.646Z",
};

/** Force the IcoMoon exports to follow the current text color. */
const tint = (svg: string) =>
  svg
    .replace(/<!--[\s\S]*?-->/g, "")
    .replace(/<title>[\s\S]*?<\/title>/, "")
    .replace(/(fill|stroke)="#000(000)?"/g, '$1="currentColor"')
    .replace(/\s(width|height)="[^"]*"/g, "")
    .replace("<svg", '<svg fill="currentColor" aria-hidden="true" focusable="false"');

const raw = { logo: tint(logoRaw), signature: tint(signatureRaw) };

export type IconName = keyof typeof brand | keyof typeof stroke | keyof typeof raw;

type Props = {
  name: IconName;
  size?: number;
  class?: string;
  label?: string;
};

const { name, size = 18, class: className, label } = Astro.props;
const a11y = label ? ({ role: "img", "aria-label": label } as const) : ({ "aria-hidden": "true" } as const);
---

{
  name in raw ? (
    <span class:list={["inline-flex [&>svg]:h-auto [&>svg]:w-full", className]} style={`width:${size}px`} set:html={raw[name as keyof typeof raw]} {...a11y} />
  ) : name in brand ? (
    <svg viewBox="0 0 24 24" width={size} height={size} fill="currentColor" class={className} focusable="false" {...a11y}>
      <path d={brand[name as keyof typeof brand]} />
    </svg>
  ) : (
    <svg
      viewBox="0 0 24 24"
      width={size}
      height={size}
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      class={className}
      focusable="false"
      {...a11y}
    >
      <path d={stroke[name as keyof typeof stroke]} />
    </svg>
  )
}
