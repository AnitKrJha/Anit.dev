---
import Icon from "./Icon.astro";
import { person, socials } from "../lib/site";

const year = new Date().getFullYear();
---

<footer class="shell mt-[var(--space-section)] pb-10">
  <div class="flex flex-col gap-8 border-t border-line pt-8 sm:flex-row sm:items-end sm:justify-between">
    <div class="flex flex-col gap-3">
      <Icon name="signature" size={64} class="text-ink" />
      <p class="text-sm text-ink-3">
        © {year} {person.name}. Built with Astro, hosted on Vercel.
      </p>
    </div>
    <ul class="flex items-center gap-1" aria-label="Elsewhere">
      {
        socials.map((s) => (
          <li>
            <a
              href={s.url}
              target="_blank"
              rel="me noopener"
              class="grid size-9 place-items-center rounded-full text-ink-3 transition-colors duration-200 hover:bg-surface hover:text-ink"
              aria-label={`${s.label} (@${s.handle})`}
              title={s.label}
            >
              <Icon name={s.icon} size={16} />
            </a>
          </li>
        ))
      }
      <li>
        <a
          href="/rss.xml"
          class="grid size-9 place-items-center rounded-full text-ink-3 transition-colors duration-200 hover:bg-surface hover:text-ink"
          aria-label="RSS feed"
          title="RSS feed"
          data-astro-reload
        >
          <Icon name="rss" size={14} />
        </a>
      </li>
    </ul>
  </div>
</footer>
