---
import BaseLayout from "../Layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
---

<BaseLayout
  title="Page not found"
  description="This page doesn't exist or has moved. Head back to the home page, the blog or the projects."
  noindex
>
  <section class="flex min-h-[55vh] flex-col items-start justify-center pt-10">
    <p class="glitch rise select-none text-[clamp(6rem,4rem+12vw,11rem)] font-[780] leading-[0.85] tracking-[-0.06em] text-ink" style="--i:0" aria-hidden="true">
      404
    </p>
    <h1 class="rise mt-6 text-[length:var(--step-2)] font-bold tracking-[-0.03em]" style="--i:1">Page not found</h1>
    <p class="rise mt-3 max-w-[30rem]" style="--i:2">
      It might have moved, or it never existed. Either way, here's a way back.
    </p>
    <div class="rise mt-7 flex flex-wrap gap-2" style="--i:3">
      <a
        href="/"
        class="inline-flex items-center gap-1.5 rounded-full bg-ink px-4 py-2 text-sm font-medium text-bg transition-opacity duration-200 hover:opacity-85"
      >
        <Icon name="arrow-left" size={14} /> Home
      </a>
      <a href="/blog" class="inline-flex items-center rounded-full px-4 py-2 text-sm font-medium text-ink ring-1 ring-line transition duration-200 hover:ring-line-strong">Blog</a>
      <a href="/projects" class="inline-flex items-center rounded-full px-4 py-2 text-sm font-medium text-ink ring-1 ring-line transition duration-200 hover:ring-line-strong">Projects</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* A small nod to the old glitch page: chromatic offsets in the aurora colours. */
  .glitch {
    text-shadow:
      -0.025em 0 0 var(--aurora-2),
      0.025em 0 0 var(--aurora-3);
    animation:
      rise 900ms var(--ease-out) both,
      jitter 4s steps(1) 1s infinite;
  }

  @keyframes jitter {
    0%,
    92%,
    100% {
      transform: none;
      clip-path: none;
    }
    94% {
      transform: translate3d(-3px, 0, 0);
      clip-path: inset(10% 0 55% 0);
    }
    96% {
      transform: translate3d(3px, 0, 0);
      clip-path: inset(50% 0 12% 0);
    }
  }
</style>
