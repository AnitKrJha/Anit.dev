---
import { Image, getImage } from "astro:assets";
import BaseLayout from "../Layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import ProjectRow from "../components/ProjectRow.astro";
import PostRow from "../components/PostRow.astro";
import { getPosts, getProjects } from "../lib/content";
import { experience, person, socials, toolbox, SITE_URL } from "../lib/site";
import { ogImageUrl } from "../lib/og";
import portrait from "../assets/Others/anit-portrait.jpg";
import keyboard from "../assets/Others/potrait_keyboard.jpg";
import campus from "../assets/Others/nsit.jpg";
import leaf from "../assets/Others/leaves.jpg";

const [projects, posts] = await Promise.all([getProjects(), getPosts()]);
const latestPosts = posts.slice(0, 4);

const photos = [
  { src: keyboard, alt: "A laptop keyboard glowing pink and violet in the dark" },
  { src: campus, alt: "A lamp post in front of the red-brick NSUT Delhi campus at dusk" },
  { src: leaf, alt: "Close-up of a blue-toned leaf covered in water droplets" },
];

const portraitUrl = new URL((await getImage({ src: portrait, width: 396, format: "jpg" })).src, SITE_URL).href;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    url: SITE_URL,
    mainEntity: {
      "@type": "Person",
      "@id": `${SITE_URL}/#person`,
      name: person.name,
      alternateName: person.fullName,
      url: SITE_URL,
      image: portraitUrl,
      jobTitle: person.role,
      worksFor: {
        "@type": "Organization",
        name: person.team,
        alternateName: person.teamShort,
        parentOrganization: { "@type": "Organization", name: person.company, url: "https://www.apple.com" },
      },
      alumniOf: { "@type": "CollegeOrUniversity", name: person.school },
      knowsAbout: person.knowsAbout,
      sameAs: socials.map((s) => s.url),
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: person.name,
    url: SITE_URL,
    author: { "@id": `${SITE_URL}/#person` },
  },
];
---

<BaseLayout
  title={`${person.name} · ${person.role} at ${person.company}`}
  rawTitle
  description={person.summary}
  image={ogImageUrl({
    variant: "profile",
    title: person.name,
    description: `${person.role} at ${person.company}`,
    meta: "Kubernetes · Crossplane · Go · React",
  })}
  imageAlt={`${person.name}, ${person.role} at ${person.company}`}
  type="profile"
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="pt-14 sm:pt-20" aria-labelledby="intro">
    <div class="flex flex-col-reverse gap-8 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="rise flex items-center gap-2.5 text-[0.9375rem] font-medium text-ink-2" style="--i:0">
          <span class="now-dot" aria-hidden="true"></span>
          <span>
            {person.role} at
            <span class="whitespace-nowrap text-ink"
              ><Icon name="apple" size={14} class="mx-0.5 -translate-y-px align-middle" />{person.company}</span
            >
          </span>
        </p>
        <h1
          id="intro"
          class="rise mt-4 text-[length:var(--step-hero)] font-[760] leading-[0.95] tracking-[-0.045em]"
          style="--i:1"
        >
          Hi, I'm <br />Anit Jha.
        </h1>
      </div>
      <div class="rise w-28 shrink-0 sm:w-36" style="--i:2">
        <Image
          src={portrait}
          alt="Anit Jha smiling, leaning on a steel railing under a tree at night"
          widths={[144, 288, 396]}
          sizes="(min-width: 640px) 144px, 112px"
          loading="eager"
          class="aspect-[3/4] w-full rotate-[2.5deg] rounded-2xl object-cover shadow-[0_18px_40px_-18px_oklch(0.2_0.05_300/0.45)] ring-1 ring-line"
        />
      </div>
    </div>

    <div class="mt-9 max-w-[38rem] space-y-4 text-[1.1rem] leading-[1.7]">
      <p class="rise" style="--i:3">
        I'm {person.age} and work on DevOps, tools and automation at the Apple Online Store. Day to day that means
        infrastructure as code with <strong class="font-semibold text-ink">Crossplane</strong> and
        <strong class="font-semibold text-ink">Kubernetes</strong>, tooling in <strong class="font-semibold text-ink">Go</strong>,
        and internal web apps in <strong class="font-semibold text-ink">React</strong> and TypeScript.
      </p>
      <p class="rise" style="--i:4">
        I started there as an intern on the checkout team in early 2025, writing Scala. Outside work I build websites for small businesses and
        friends, play a lot of chess, write about the tools I use, and keep a little
        <a href="https://recipies.anit.dev" target="_blank" rel="noopener" class="link">recipe site</a>.
      </p>
    </div>

    <ul class="rise mt-8 flex flex-wrap gap-2" style="--i:5" aria-label="Find me elsewhere">
      {
        socials.map((s) => (
          <li>
            <a
              href={s.url}
              target="_blank"
              rel="me noopener"
              class="inline-flex items-center gap-2 rounded-full px-3.5 py-1.5 text-sm font-medium text-ink-2 ring-1 ring-line transition duration-200 hover:text-ink hover:ring-line-strong"
            >
              <Icon name={s.icon} size={14} />
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Photos -->
  <div class="section grid grid-cols-3 gap-3 sm:gap-4" aria-label="Photos">
    {
      photos.map((photo, i) => (
        <Image
          src={photo.src}
          alt={photo.alt}
          widths={[240, 480]}
          sizes="(min-width: 768px) 230px, 33vw"
          class:list={[
            "aspect-[3/4] w-full rounded-xl object-cover ring-1 ring-line",
            i === 1 && "translate-y-5 sm:translate-y-8",
          ]}
        />
      ))
    }
  </div>

  <!-- Experience -->
  <section class="section" aria-labelledby="experience">
    <h2 id="experience" class="section-title">Experience</h2>
    <ol class="mt-6">
      {
        experience.map((role) => (
          <li class="grid gap-1.5 border-t border-line py-6 first:border-t-0 sm:grid-cols-[8rem_1fr] sm:gap-6">
            <p class="nums flex items-center gap-2 pt-0.5 text-sm text-ink-3">
              {role.current && <span class="now-dot" aria-hidden="true" />}
              {role.when}
            </p>
            <div>
              <h3 class="text-[1.075rem] font-semibold leading-snug tracking-[-0.015em]">{role.title}</h3>
              <p class="flex items-center gap-1.5 text-sm text-ink-3">
                {role.apple && <Icon name="apple" size={13} class="-translate-y-px text-ink-2" />}
                {role.org}
              </p>
              <p class="mt-2.5 text-[0.975rem] leading-relaxed">{role.summary}</p>
              {role.stack.length > 0 && <p class="tag mt-2.5">{role.stack.join(" · ")}</p>}
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Projects -->
  <section class="section" aria-labelledby="projects">
    <div class="flex items-baseline justify-between">
      <h2 id="projects" class="section-title">Selected projects</h2>
      <a href="/projects" class="more">All projects <Icon name="arrow-up-right" size={14} /></a>
    </div>
    <div class="mt-6">
      {projects.map((project) => <ProjectRow project={project} />)}
    </div>
  </section>

  <!-- Toolbox -->
  <section class="section" aria-labelledby="toolbox">
    <h2 id="toolbox" class="section-title">Toolbox</h2>
    <dl class="mt-6">
      {
        toolbox.map((group) => (
          <div class="grid gap-1 border-t border-line py-4 first:border-t-0 sm:grid-cols-[8rem_1fr] sm:gap-6">
            <dt class="text-sm text-ink-3">{group.label}</dt>
            <dd class="text-[0.975rem] text-ink">{group.items.join(", ")}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- Writing -->
  <section class="section" aria-labelledby="writing">
    <div class="flex items-baseline justify-between">
      <h2 id="writing" class="section-title">Writing</h2>
      <a href="/blog" class="more">All posts <Icon name="arrow-up-right" size={14} /></a>
    </div>
    <ul class="mt-4">
      {latestPosts.map((post) => <PostRow post={post} />)}
    </ul>
  </section>
</BaseLayout>

<style>
  .now-dot {
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
    flex-shrink: 0;
  }
</style>
