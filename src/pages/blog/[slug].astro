---
import { getCollection, type CollectionEntry } from "astro:content";
import { Image, getImage } from "astro:assets";
import BaseLayout from "../../Layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import CodeCopy from "../../components/CodeCopy.astro";
import PostRow from "../../components/PostRow.astro";
import { getPosts } from "../../lib/content";
import { formattedDate, isoDate, readingTime } from "../../lib/utils";
import { person, SITE_URL } from "../../lib/site";
import { ogImageUrl } from "../../lib/og";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

type Props = {
  post: CollectionEntry<"blog">;
};

const { post } = Astro.props;
const { date, isDraft, title: rawTitle, description, image, ogImage, tags } = post.data;
const title = rawTitle.trim();
const { Content } = await post.render();

// Up to two other posts, preferring ones that share a tag.
const others = (await getPosts()).filter((p) => p.slug !== post.slug);
const shares = (p: (typeof others)[number]) => p.data.tags.some((t) => tags.includes(t));
const related = [...others.filter(shares), ...others.filter((p) => !shares(p))].slice(0, 2);

const coverUrl = image ? (await getImage({ src: image, width: 1200, format: "jpg" })).src : undefined;
const minutes = readingTime(post.body);
// Frontmatter `ogImage` wins; otherwise an og.anit.dev card with the cover as a thumbnail.
const shareImage =
  ogImage ??
  ogImageUrl({
    title,
    type: "Blog",
    description,
    meta: `${formattedDate(date)} · ${minutes} min read`,
    image: coverUrl,
  });
const url = `${SITE_URL}/blog/${post.slug}`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    url,
    mainEntityOfPage: url,
    datePublished: date.toISOString(),
    keywords: tags.join(", "),
    ...(coverUrl && { image: new URL(coverUrl, SITE_URL).href }),
    author: { "@type": "Person", name: person.name, url: SITE_URL },
    publisher: { "@type": "Person", name: person.name, url: SITE_URL },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: SITE_URL },
      { "@type": "ListItem", position: 2, name: "Blog", item: `${SITE_URL}/blog` },
      { "@type": "ListItem", position: 3, name: title, item: url },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  image={shareImage}
  imageAlt={`${title}, a post by ${person.name}`}
  type="article"
  publishedTime={date}
  tags={tags}
  noindex={isDraft}
  jsonLd={jsonLd}
>
  <article class="pt-10 sm:pt-14">
    <a href="/blog" class="more">
      <Icon name="arrow-left" size={14} /> Blog
    </a>

    {
      isDraft && (
        <p class="mt-6 rounded-xl bg-surface px-4 py-3 text-sm" role="note">
          This post is a <strong class="text-ink">draft</strong>. If you're reading it, you're probably a trusted
          person. Please don't share it yet.
        </p>
      )
    }

    <header class="mt-6">
      <h1
        class="text-[1.9rem] font-bold leading-[1.1] tracking-[-0.035em] sm:text-[2.5rem]"
        transition:name={`post-${post.slug}-title`}
      >
        {title}
      </h1>
      <p class="mt-4 flex flex-wrap items-center gap-x-2 text-sm text-ink-3">
        <time datetime={isoDate(date)}>{formattedDate(date)}</time>
        <span aria-hidden="true">·</span>
        <span>{minutes} min read</span>
        {
          tags.length > 0 && (
            <>
              <span aria-hidden="true">·</span>
              <span>{tags.slice(0, 3).join(", ")}</span>
            </>
          )
        }
      </p>
    </header>

    {
      image && (
        <figure class="mt-8 overflow-hidden rounded-2xl bg-surface ring-1 ring-line">
          <Image
            src={image}
            alt=""
            widths={[704, 1056, 1408]}
            sizes="(min-width: 768px) 704px, 100vw"
            loading="eager"
            class="aspect-video w-full object-cover"
          />
        </figure>
      )
    }

    <div class="prose mt-10">
      <Content />
    </div>
    <CodeCopy />

    <footer class="mt-14 border-t border-line pt-6 text-sm">
      <p class="text-ink-3">
        Written by <a href="/" class="link">{person.name}</a>, a DevOps, tools and automation engineer at Apple. Found a
        mistake? Tell me on <a href="https://x.com/_anitjha" target="_blank" rel="noopener" class="link">X</a> or
        <a href="https://www.linkedin.com/in/anitjha" target="_blank" rel="noopener" class="link">LinkedIn</a>.
      </p>
    </footer>

    {
      related.length > 0 && (
        <section class="section" aria-labelledby="keep-reading">
          <div class="flex items-baseline justify-between">
            <h2 id="keep-reading" class="section-title">Keep reading</h2>
            <a href="/blog" class="more">All posts <Icon name="arrow-up-right" size={14} /></a>
          </div>
          <ul class="mt-4">
            {related.map((p) => <PostRow post={p} detailed headingLevel="h3" />)}
          </ul>
        </section>
      )
    }
  </article>
</BaseLayout>
