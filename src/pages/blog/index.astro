---
import BaseLayout from "../../Layouts/BaseLayout.astro";
import PostRow from "../../components/PostRow.astro";
import { getPosts } from "../../lib/content";
import { person, SITE_URL } from "../../lib/site";
import { ogImageUrl } from "../../lib/og";

const posts = await getPosts();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: `${person.name}'s blog`,
  url: `${SITE_URL}/blog`,
  author: { "@type": "Person", name: person.name, url: SITE_URL },
  blogPost: posts.map((post) => ({
    "@type": "BlogPosting",
    headline: post.data.title.trim(),
    url: `${SITE_URL}/blog/${post.slug}`,
    datePublished: post.data.date.toISOString(),
  })),
};
---

<BaseLayout
  title="Blog"
  description="Notes and guides by Anit Jha on Git, terminals, Linux and the tools developers use every day."
  image={ogImageUrl({
    title: "Blog",
    type: "Writing",
    description: "Notes and guides on Git, terminals, Linux and the tools developers use every day.",
    meta: `${posts.length} posts`,
  })}
  jsonLd={jsonLd}
>
  <header class="pt-14 sm:pt-20">
    <h1 class="rise text-[length:var(--step-2)] font-bold tracking-[-0.035em] sm:text-[2.6rem]" style="--i:0">Blog</h1>
    <p class="rise mt-3 max-w-[34rem] text-[1.075rem]" style="--i:1">
      Notes on the tools I use, mostly written so future me stops googling the same thing.
      <a href="/rss.xml" class="link" data-astro-reload>Subscribe via RSS</a>.
    </p>
  </header>

  <ul class="mt-10">
    {posts.map((post) => <PostRow post={post} detailed />)}
  </ul>
</BaseLayout>
