---
import { getCollection, type CollectionEntry } from "astro:content";
import { Image, getImage } from "astro:assets";
import BaseLayout from "../../Layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import CodeCopy from "../../components/CodeCopy.astro";
import ProjectRow from "../../components/ProjectRow.astro";
import { getProjects } from "../../lib/content";
import ProjectDummyImage from "../../content/project-dummy.png";
import { person, SITE_URL } from "../../lib/site";
import { ogImageUrl } from "../../lib/og";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

type Props = {
  project: CollectionEntry<"projects">;
};

const { project } = Astro.props;
const { isDraft, name, description, image, imageAlt, ghLink, liveLink, year, role, tags } = project.data;
const { Content } = await project.render();
const more = (await getProjects()).filter((p) => p.slug !== project.slug).slice(0, 2);

const cover = image ?? ProjectDummyImage;
const coverUrl = (await getImage({ src: cover, width: 1200, format: "jpg" })).src;
const shareImage = ogImageUrl({
  title: name,
  type: "Project",
  description,
  meta: [year, tags.slice(0, 3).join(", ")].filter(Boolean).join(" · "),
  image: coverUrl,
});
const url = `${SITE_URL}/projects/${project.slug}`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    name,
    description,
    url,
    image: new URL(coverUrl, SITE_URL).href,
    dateCreated: year ? String(year) : undefined,
    keywords: tags.join(", "),
    creator: { "@type": "Person", name: person.name, url: SITE_URL },
    ...(liveLink && { sameAs: liveLink }),
    ...(ghLink && { codeRepository: ghLink }),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: SITE_URL },
      { "@type": "ListItem", position: 2, name: "Projects", item: `${SITE_URL}/projects` },
      { "@type": "ListItem", position: 3, name, item: url },
    ],
  },
];
---

<BaseLayout
  title={name}
  description={description}
  image={shareImage}
  imageAlt={imageAlt}
  noindex={isDraft}
  jsonLd={jsonLd}
>
  <article class="pt-10 sm:pt-14">
    <a href="/projects" class="more">
      <Icon name="arrow-left" size={14} /> Projects
    </a>

    {
      isDraft && (
        <p class="mt-6 rounded-xl bg-surface px-4 py-3 text-sm" role="note">
          This is a <strong class="text-ink">draft</strong>. If you're reading it, you're probably a trusted person.
          Please don't share it yet.
        </p>
      )
    }

    <header class="mt-6">
      <h1 class="text-[length:var(--step-2)] font-bold leading-[1.05] tracking-[-0.035em] sm:text-[2.6rem]">{name}</h1>
      <dl class="mt-5 flex flex-wrap gap-x-8 gap-y-2 text-sm">
        {
          year && (
            <div class="flex gap-2">
              <dt class="text-ink-3">Year</dt>
              <dd class="nums text-ink">{year}</dd>
            </div>
          )
        }
        {
          role && (
            <div class="flex gap-2">
              <dt class="text-ink-3">Role</dt>
              <dd class="text-ink">{role}</dd>
            </div>
          )
        }
        {
          tags.length > 0 && (
            <div class="flex gap-2">
              <dt class="text-ink-3">Stack</dt>
              <dd class="text-ink">{tags.join(", ")}</dd>
            </div>
          )
        }
      </dl>
      {
        (liveLink || ghLink) && (
          <div class="mt-5 flex flex-wrap gap-2">
            {liveLink && (
              <a
                href={liveLink}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-1.5 rounded-full bg-ink px-4 py-2 text-sm font-medium text-bg transition-opacity duration-200 hover:opacity-85"
              >
                Visit site <Icon name="arrow-up-right" size={14} />
              </a>
            )}
            {ghLink && (
              <a
                href={ghLink}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-1.5 rounded-full px-4 py-2 text-sm font-medium text-ink ring-1 ring-line transition duration-200 hover:ring-line-strong"
              >
                <Icon name="github" size={14} /> Source
              </a>
            )}
          </div>
        )
      }
    </header>

    <figure class="mt-9 overflow-hidden rounded-2xl bg-surface ring-1 ring-line">
      <Image
        src={cover}
        alt={imageAlt ?? `${name} cover`}
        widths={[704, 1056, 1408]}
        sizes="(min-width: 768px) 704px, 100vw"
        loading="eager"
        class="aspect-[1200/630] w-full object-cover"
        transition:name={`project-${project.slug}-image`}
      />
    </figure>

    <div class="prose mt-10">
      <Content />
    </div>
    <CodeCopy />

    {
      more.length > 0 && (
        <section class="section" aria-labelledby="more-projects">
          <div class="flex items-baseline justify-between">
            <h2 id="more-projects" class="section-title">More projects</h2>
            <a href="/projects" class="more">All projects <Icon name="arrow-up-right" size={14} /></a>
          </div>
          <div class="mt-6">
            {more.map((p) => <ProjectRow project={p} />)}
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>
